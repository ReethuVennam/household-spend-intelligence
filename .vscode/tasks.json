{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run full pipeline",
      "type": "shell",
      "command": "python -m src.cli all --scale full --seed 20261022 --out dataset --formats csv,json,sql",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Generate, validate, evaluate, dashboard, and React data payload"
    },
    {
      "label": "Validate only",
      "type": "shell",
      "command": "python -m src.cli validate --dataset dataset",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Evaluate only",
      "type": "shell",
      "command": "python -m src.cli evaluate --dataset dataset",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Rebuild dashboard",
      "type": "shell",
      "command": "python -m src.cli dashboard --dataset dataset",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Open dashboard in browser",
      "type": "shell",
      "command": "start dataset\\dashboard.html",
      "windows": {
        "command": "start dataset\\dashboard.html"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Rebuild React data payload",
      "type": "shell",
      "command": "python -m src.cli webdata --dataset dataset",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Build React dashboard",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/web" },
      "group": "build",
      "problemMatcher": [],
      "detail": "Vite build -> web/dist/index.html (single file)"
    },
    {
      "label": "Open React dashboard in browser",
      "type": "shell",
      "command": "start web\\dist\\index.html",
      "windows": {
        "command": "start web\\dist\\index.html"
      },
      "group": "none",
      "problemMatcher": []
    }
  ]
}
